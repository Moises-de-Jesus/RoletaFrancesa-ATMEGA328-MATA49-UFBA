; Ligar verde = 0xF4
; Ligar vermelho = 0xF2
; Ligar branco = 0xF8

LIGAR_LED:
    RCALL OBTER_RESULTADO
	RCALL DECODIFICADOR_CORES
	RCALL EXIBIR_COR
	RET

OBTER_RESULTADO:
    MUL GANHADOR_DEZENAS, SALTO_DEZENAS
    ADD RESULTADO_COR, R0
    ADD RESULTADO_COR, GANHADOR_UNIDADES

DECODIFICADOR_CORES:
	LDI ZH, HIGH(TABELA_CORES << 1)
	LDI ZL, LOW (TABELA_CORES << 1)
	ADD ZL, RESULTADO_COR
	ADC ZH, R5
	RET

EXIBIR_COR:
	LPM R8, Z
	OUT PORTB, R8
    CLR RESULTADO_COR
	RET

TABELA_CORES: .DB 0xF4, 0xF2, 0xF8, 0xF2, 0xF8, 0xF2, 0xF8, 0xF2, 0xF8, 0xF2, 0xF8, 0xF8, 0xF2, 0xF8, 0xF2, 0xF8, 0xF2, 0xF8, 0xF2, 0xF2, 0xF8, 0xF2, 0xF8, 0xF2, 0xF8, 0xF2, 0xF8, 0xF2, 0xF8, 0xF8, 0xF2, 0xF8, 0xF2, 0xF8, 0xF2, 0xF8, 0xF2, 0x00