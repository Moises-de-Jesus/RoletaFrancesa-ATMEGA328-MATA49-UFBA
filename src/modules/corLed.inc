; Ligar verde = 0xF4
; Ligar vermelho = 0xF2
; Ligar branco = 0xF8

LIGAR_LED:
	RCALL DECODIFICADOR_CORES
	RCALL EXIBIR_COR
	RET

DECODIFICADOR_CORES:
	LDI ZH, HIGH(TABELA_CORES << 1)
	LDI ZL, LOW (TABELA_CORES << 1)
	ADD ZL, GANHADOR
	ADC ZH, R5
	RET

EXIBIR_COR:
	LPM R0, Z
	OUT PORTB, R0 
	RET

TABELA_CORES: .DB 0xF4, 0xF2, 0xF8, 0xF2, 0xF8, 0xF2, 0xF8, 0xF2, 0xF8, 0xF2, 0xF8, 0xF8, 0xF2, 0xF8, 0xF2, 0xF8, 0xF2, 0xF8, 0xF2, 0xF2, 0xF8, 0xF2, 0xF8, 0xF2, 0xF8, 0xF2, 0xF8, 0xF2, 0xF8, 0xF8, 0xF2, 0xF8, 0xF2, 0xF8, 0xF2, 0xF8, 0xF2, 0x00